config {
  type: "table",
  schema: "chicago_taxi_analytics",
  description: "Bonus Insight 2: Trip demand by hour of day and pickup community area. Aggregated across the full 2013-2023 dataset. Business value: identifies when and where demand is highest, enabling data-driven driver deployment decisions -- putting more drivers in high-demand areas during peak hours reduces passenger wait times and increases driver utilisation.",
  columns: {
    pickup_community_area: "Chicago community area code for the pickup location (1-77). NULL values are suppressed by the City for privacy in low-volume areas.",
    trip_start_hour: "Hour of day (0-23, US/Chicago local time) when the trip started.",
    day_type: "Weekday vs Weekend classification. Demand patterns differ significantly between the two, so separating them makes the heatmap more actionable for deployment planning.",
    total_trips: "Total number of trips originating from this community area at this hour and day type across the full dataset.",
    avg_daily_trips: "Average number of trips per day for this community area / hour / day type combination. More comparable across day types than total_trips since there are roughly 5x more weekdays than weekend days.",
    avg_fare: "Average base fare for trips from this pickup location and hour, in USD.",
    avg_trip_duration_mins: "Average trip duration in minutes for trips from this pickup location and hour.",
    demand_rank_overall: "Rank of this community_area + hour + day_type combination by avg_daily_trips, from highest (1) to lowest demand. Useful for filtering to top pickup hotspots."
  }
}

WITH base AS (
  SELECT
    pickup_community_area,
    trip_start_hour,
    CASE
      WHEN FORMAT_DATE('%A', trip_start_date) IN ('Saturday', 'Sunday')
      THEN 'Weekend'
      ELSE 'Weekday'
    END AS day_type,
    trip_start_date,
    fare,
    trip_seconds
  FROM ${ref("stg_taxi_trips")}
  WHERE pickup_community_area IS NOT NULL
),

aggregated AS (
  SELECT
    pickup_community_area,
    trip_start_hour,
    day_type,
    COUNT(*) AS total_trips,
    COUNT(DISTINCT trip_start_date) AS distinct_days,
    ROUND(AVG(fare), 2) AS avg_fare,
    ROUND(AVG(trip_seconds / 60.0), 2) AS avg_trip_duration_mins
  FROM base
  GROUP BY pickup_community_area, trip_start_hour, day_type
),

with_daily_avg AS (
  SELECT
    *,
    ROUND(SAFE_DIVIDE(total_trips, distinct_days), 2) AS avg_daily_trips
  FROM aggregated
)

SELECT
  pickup_community_area,
  trip_start_hour,
  day_type,
  total_trips,
  avg_daily_trips,
  avg_fare,
  avg_trip_duration_mins,
  RANK() OVER (ORDER BY avg_daily_trips DESC) AS demand_rank_overall
FROM with_daily_avg
ORDER BY avg_daily_trips DESC