config {
  type: "table",
  schema: "chicago_taxi_analytics",
  description: "Answers Question 2: the top 100 taxi IDs that 'overwork' -- defined as drivers who regularly work long shifts (12+ hours) without an 8-hour break, over the last 3 months of available data (Q4 2023). Ranking combines both the frequency of long shifts and total hours worked, since a single long shift is an anomaly but a pattern of them is overworking.",
  columns: {
    taxi_id: "Anonymized taxi/driver identifier.",
    total_shifts: "Total number of distinct shifts (as reconstructed by the 8-hour-gap rule) in the analysis window.",
    long_shifts_count: "Number of shifts in the analysis window lasting 12 hours or more.",
    long_shift_rate_pct: "Percentage of this driver's shifts that were long shifts (long_shifts_count / total_shifts). Captures regularity/consistency of overworking, independent of how much they drive overall.",
    total_hours_worked: "Sum of all shift durations in the analysis window, in hours.",
    avg_shift_duration_hours: "Average shift duration across all shifts in the analysis window.",
    max_shift_duration_hours: "Longest single shift duration observed in the analysis window, in hours.",
    overwork_score: "Composite ranking score = long_shifts_count * long_shift_rate_pct. Rewards drivers who both frequently AND consistently work long shifts, rather than drivers who simply drive a huge volume of total shifts (some of which happen to be long).",
    overwork_rank: "Rank from 1 (most overworked) to 100, based on overwork_score."
  }
}

-- ============================================================================
-- MART: Q2 - Top 100 Overworkers
-- ============================================================================
-- Question: "Who are the top 100 'overworkers', taxi IDs that work more hours
--            than others without taking at least 8 hours break and regularly
--            have a long shift? ... consider the shifts that taxi drivers
--            might typically work."
--
-- ASSUMPTIONS / METHODOLOGY:
--   1. Shifts are reconstructed in stg_driver_shifts using an 8-hour gap
--      rule -- see that model's header comment for full reasoning. This
--      directly operationalizes "without taking at least 8 hours break":
--      any shift in this table is, by construction, a span of driving with
--      no break of 8+ hours inside it.
--   2. "Long shift" is defined as 12+ hours. Typical commercial driver
--      shifts run 8-12 hours; we treat 12+ as exceeding the normal range
--      and worth flagging, consistent with the question's prompt to
--      consider what a typical shift looks like.
--   3. "Regularly" is captured via long_shift_rate_pct (the proportion of a
--      driver's shifts that are long), not just a raw count. A driver who
--      works 50 shifts and 5 are long (10%) is a different risk profile
--      than a driver who works 6 shifts and 5 are long (83%) -- the second
--      driver is overworking far more consistently even though the first
--      has a higher raw count. The ranking score
--      (long_shifts_count * long_shift_rate_pct) rewards drivers who are
--      high on BOTH frequency and consistency, rather than purely high
--      volume.
--   4. Analysis window matches Q1 for comparability: 2023-10-01 to
--      2023-12-31 (last 3 months of available data, relative to the
--      dataset's own max date, not real-world today).
--   5. Shifts are attributed to the window based on shift_start_date. A
--      shift that starts within the window but technically ends just after
--      it (e.g. starts 11pm Dec 31) is still counted -- excluding it would
--      arbitrarily truncate real driver behavior at a calendar boundary.
-- ============================================================================

WITH window_shifts AS (
  SELECT
    taxi_id,
    shift_id,
    shift_duration_hours,
    trip_count_in_shift
  FROM ${ref("stg_driver_shifts")}
  WHERE shift_start_date BETWEEN '2023-10-01' AND '2023-12-31'
),

per_taxi AS (
  SELECT
    taxi_id,
    COUNT(*) AS total_shifts,
    COUNTIF(shift_duration_hours >= 12) AS long_shifts_count,
    ROUND(SAFE_DIVIDE(COUNTIF(shift_duration_hours >= 12), COUNT(*)) * 100, 2) AS long_shift_rate_pct,
    ROUND(SUM(shift_duration_hours), 2) AS total_hours_worked,
    ROUND(AVG(shift_duration_hours), 2) AS avg_shift_duration_hours,
    ROUND(MAX(shift_duration_hours), 2) AS max_shift_duration_hours
  FROM window_shifts
  GROUP BY taxi_id
  HAVING COUNT(*) >= 5
),

scored AS (
  SELECT
    *,
    ROUND(long_shifts_count * (long_shift_rate_pct / 100.0), 2) AS overwork_score
  FROM per_taxi
),

ranked AS (
  SELECT
    *,
    RANK() OVER (ORDER BY overwork_score DESC) AS overwork_rank
  FROM scored
)

SELECT *
FROM ranked
WHERE overwork_rank <= 100
ORDER BY overwork_rank